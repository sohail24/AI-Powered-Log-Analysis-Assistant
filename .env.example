# ─── Environment Configuration ───────────────────────────────────
# Copy this file to .env and fill in your values.

# Paths (defaults work for local development)
# LOG_DIRECTORY=./data/logs
# DB_PATH=./data/log_analysis.db
# VECTOR_DB_PATH=./data/vector_db
# RAW_LOG_STORE_PATH=./data/raw_logs

# LLM
ANTHROPIC_API_KEY=your-api-key-here
# LLM_MODEL=claude-sonnet-4-6
# LLM_MAX_TOKENS=1024
# LLM_PROMPT_VERSION=v1.0

# Ingestion
# MAX_ERROR_LINES_IN_DIGEST=30
# ORPHAN_WINDOW_SIZE=10
# AUTO_RETRY_GAP_MINUTES=5

# RAG
# RAG_TOP_K_CHUNKS=8
# CHUNK_CONTEXT_WINDOW=10
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Alerting
# SLACK_WEBHOOK_URL=
# ALERT_ON_CRITICAL=true

# Environment: prod | staging | uat
# ENVIRONMENT=prod
